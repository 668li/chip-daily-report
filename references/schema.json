{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "chip-daily-report://ir/v1",
  "title": "芯片行业日报 · 结构化中间表示（IR / 单一数据源）",
  "description": "M0 结构化中间表示。LLM 产出此 dict，由 scripts/report_renderer.py 渲染为 Markdown（validate_report.py 的校验对象），或直接喂给 report_viz.build_report_html(report) 生成 HTML（--json 模式，不经过正则 parser）。本 schema 是渲染器与（未来 M2）LLM 直出 JSON 的契约。",
  "type": "object",
  "required": ["title", "gen_time", "coverage", "news_count", "segments", "selfcheck"],
  "properties": {
    "title": {"type": "string", "description": "一级标题，形如 '芯片行业日报 — 2026-08-17'"},
    "gen_time": {"type": "string", "description": "生成时间，形如 '2026-08-17 11:35'"},
    "coverage": {"type": "string", "description": "覆盖范围，如 '2026年8月14日-17日（周一；含周末关键动态）'"},
    "news_count": {"type": "integer", "description": "新闻总数（须等于各 segments 条数之和）"},
    "highlights": {
      "type": "array", "description": "今日要点（1-3 条）",
      "items": {"type": "string"}
    },
    "segments": {
      "type": "object",
      "description": "5 环节（+可选综合）新闻，key ∈ 设计/制造/封测/EDA/材料/综合",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["title", "summary", "sources", "timestamp"],
          "properties": {
            "title": {"type": "string"},
            "is_review": {"type": "boolean", "description": "是否超72h，渲染时标题加 [回顾] 前缀"},
            "summary": {"type": "string", "description": "80-150字摘要，含技术维度；可含 [技术注解]/（原始：X）"},
            "annotation": {"type": ["string", "null"], "description": "技术注解内容（无则 null），渲染为 [技术注解: X]"},
            "origin": {"type": ["string", "null"], "description": "原始来源注记（无则 null），渲染为（原始：X）"},
            "sources": {
              "type": "array",
              "description": "来源链接；news 为 (name,url) 元组，catalyst 为 {name,url,level}",

              "items": {
                "oneOf": [
                  {"type": "array", "items": [{"type": "string"}, {"type": "string"}], "minItems": 2, "maxItems": 2},
                  {"type": "object", "properties": {"name": {"type": "string"}, "url": {"type": "string"}, "level": {"type": "string"}}}
                ]
              }
            },
            "level": {"type": "string", "enum": ["A", "B", "C"], "description": "统一来源级别（由域名判定）"},
            "timestamp": {"type": "string", "description": "来源发布日期，如 '2026-08-17'"},
            "signal": {
              "type": ["object", "null"],
              "description": "信号层；无则 null",
              "required": ["importance", "impact", "sentiment"],
              "properties": {
                "importance": {"type": "string", "enum": ["高", "中", "低"]},
                "impact": {"type": "string", "enum": ["利好", "利空", "中性"]},
                "sentiment": {"type": "string", "enum": ["正面", "负面", "中性"]}
              }
            }
          }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "description": "横向维度（市场与需求/政策与监管/资本与投融资）",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "intro": {"type": "string", "description": "小节引言（blockquote 内容，去 > 后）"},
          "subs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {"type": "string"},
                "body": {"type": "string", "description": "子节正文（含内联来源链接）"},
                "sources": {"type": "array"},
                "level": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "chain_groups": {
      "type": "array", "description": "产业链关联组（≥2）",
      "items": {"type": "object", "properties": {"title": {"type": "string"}, "body": {"type": "string"}}}
    },
    "tracking": {
      "type": "array", "description": "持续追踪（B·v5.3）",
      "items": {"type": "object", "properties": {"topic": {"type": "string"}, "detail": {"type": "string"}}}
    },
    "forward_review": {
      "type": ["object", "null"], "description": "前瞻兑现回顾（v5.10 方向1）",
      "properties": {
        "intro": {"type": "string"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {"type": "string"},
              "parts": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}}
            }
          }
        },
        "summary": {"type": "string", "description": "闭环小结"}
      }
    },
    "catalysts": {
      "type": "array", "description": "前瞻催化剂表格（v5.3 / v5.11 六列含确定性）",
      "items": {
        "type": "object",
        "required": ["date", "event", "segment", "importance", "sources"],
        "properties": {
          "date": {"type": "string"},
          "event": {"type": "string"},
          "segment": {"type": "string"},
          "importance": {"type": "string", "enum": ["高", "中", "低"]},
          "certainty": {"type": ["string", "null"], "enum": ["高确定性", "中确定性", "低确定性", null], "description": "v5.11 确定性分级"},
          "sources": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "url": {"type": "string"}, "level": {"type": "string"}}}}
        }
      }
    },
    "catalyst_notes": {
      "type": "array", "description": "前瞻解读块（v5.11 高/中重要度催化剂配解读）",
      "items": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "parts": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}}
        }
      }
    },
    "feynman": {
      "type": "array", "description": "费曼解释（v5.4）",
      "items": {"type": "object", "properties": {"term": {"type": "string"}, "text": {"type": "string"}}}
    },
    "deep_dive": {
      "type": "array", "description": "深度解读（v5.6）",
      "items": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "parts": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}}
        }
      }
    },
    "future_lessons": {
      "type": "array", "description": "未来借鉴（v5.6 / v5.8）",
      "items": {"type": "object", "properties": {"category": {"type": "string"}, "text": {"type": "string"}}}
    },
    "tutor": {
      "type": "array", "description": "今日导师课（v5.8），模块 + 原始行",
      "items": {
        "type": "object",
        "properties": {
          "module": {"type": "string"},
          "body": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "selfcheck": {
      "type": "array", "description": "自检结果表格行（26 项）",
      "items": {
        "type": "object",
        "required": ["num", "name", "result", "note"],
        "properties": {
          "num": {"type": "integer"},
          "name": {"type": "string"},
          "result": {"type": "string", "enum": ["PASS", "FAIL", "WARN"]},
          "note": {"type": "string"}
        }
      }
    },
    "source_stats": {"type": "object", "properties": {"A": {"type": "integer"}, "B": {"type": "integer"}, "C": {"type": "integer"}}}
  }
}
